      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO citizen_requests (channel, kind, sender, contact, subject, message, location, source_ref)\nVALUES ($1, 'incoming', $2, $3, $4, $5, $6, $7)\nON CONFLICT (source_ref) WHERE source_ref IS NOT NULL DO NOTHING\nRETURNING id, ticket_no;",
        "options": {
          "queryReplacement": "={{ ['email', $json.from.replace(/<.*>/, '').trim() || $json.from, $json.from, $json.subject, ($json.textPlain || $json.text || '').slice(0, 8000), null, $json.metadata?.['message-id'] || $json.messageId || null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE",
          "name": "Postgres lab"
        }
      }
    }
