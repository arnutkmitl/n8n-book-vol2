    {
      "id": "i2",
      "name": "แยกไฟล์แนบ PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "// อีเมลหนึ่งฉบับอาจมีไฟล์แนบหลายไฟล์ แยกเป็น item ละหนึ่งไฟล์ เฉพาะ PDF\nconst out = [];\nfor (const item of $input.all()) {\n  for (const [key, bin] of Object.entries(item.binary ?? {})) {\n    if (bin.mimeType !== 'application/pdf' && !String(bin.fileName).toLowerCase().endsWith('.pdf')) continue;\n    out.push({ json: { from: item.json.from, subject: item.json.subject, file_name: bin.fileName }, binary: { data: bin } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "i3",
      "name": "ทีละไฟล์",
      "type": "n8n-nodes-base.splitInBatches",
