      "id": "i1",
      "name": "อีเมลถึงฝ่ายบัญชีเจ้าหนี้",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
