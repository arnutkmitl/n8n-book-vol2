    {
      "id": "a4",
      "name": "คำนวณราคาที่อนุมัติ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "jsCode": "// ราคาพร้อมส่วนลดพิเศษที่เกินนโยบายปกติ (ต้องผ่านการอนุมัติของผู้จัดการก่อนเครื่องมือนี้จะทำงาน)\nconst query = $('เมื่อ Agent ขอส่วนลดพิเศษ').first().json;\nconst unitPrice = Number(query.unit_price);\nconst qty = Number(query.qty);\nconst pct = Number(query.discount_percent);\nif (!(unitPrice > 0) || !(qty > 0) || !(pct > 0) || pct > 20) {\n  return [{ json: { result: 'ข้อมูลไม่ถูกต้อง ส่วนลดพิเศษต้องอยู่ระหว่าง 1 ถึง 20 เปอร์เซ็นต์' } }];\n}\nconst round2 = (n) => Math.round(n * 100) / 100;\nconst subtotal = round2(unitPrice * qty);\nconst discount = round2(subtotal * pct / 100);\nconst net = round2(subtotal - discount);\nconst vat = round2(net * 0.07);\nreturn [{ json: { result: 'ผู้จัดการอนุมัติแล้ว ' + JSON.stringify({ approved_discount_percent: pct, subtotal, discount, net, vat_7: vat, total_incl_vat: round2(net + vat) }) } }];"
      }
    },
    {
      "id": "a5",
      "name": "แจ้งไม่อนุมัติ",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "result",
              "type": "string",
              "value": "ผู้จัดการไม่อนุมัติส่วนลดพิเศษ หรือไม่ได้ตอบภายใน 30 นาที ให้แจ้งลูกค้าว่าใช้ส่วนลดตามนโยบายปกติ"
            }
          ]
        },
        "options": {}
      }
    }
