    {
      "id": "t2",
      "name": "จัดประเภทข้อความ",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "inputText": "={{ $json.body.message }}",
        "categories": {
          "categories": [
            {
              "category": "สอบถามสินค้า",
              "description": "ถามว่ามีสินค้าไหม รุ่นไหนใช้กับเครื่องอะไร สเปกหรือขนาด"
            },
            {
              "category": "ขอราคา",
              "description": "ถามราคา ขอใบเสนอราคา ถามส่วนลดหรือราคาส่ง"
            },
            {
              "category": "ติดตามการจัดส่ง",
              "description": "ถามว่าของส่งหรือยัง เลขพัสดุ ส่งกี่วัน ค่าส่ง"
            },
            {
              "category": "แจ้งปัญหาสินค้า",
              "description": "สินค้าชำรุด ผิดรุ่น ใช้ไม่ได้ ขอเปลี่ยนหรือคืน"
            },
            {
              "category": "การชำระเงิน",
              "description": "แจ้งโอนเงิน ขอใบกำกับภาษี ถามช่องทางชำระ เครดิต"
            }
          ]
        },
        "options": {
          "fallback": "other"
        }
      }
    },
    {
