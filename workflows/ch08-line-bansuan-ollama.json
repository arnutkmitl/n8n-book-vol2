    {
      "id": "q15",
      "name": "บันทึกประวัติแชต",
      "type": "@n8n/n8n-nodes-langchain.memoryManager",
      "typeVersion": 1.1,
      "position": [
        3800,
        -700
      ],
      "parameters": {
        "mode": "insert",
        "messages": {
          "messageValues": [
            {
              "type": "user",
              "message": "={{ $('เตรียมข้อมูล').item.json.text }}",
              "hideFromUI": false
            },
            {
              "type": "ai",
              "message": "={{ $json.reply_text }}",
              "hideFromUI": false
            }
