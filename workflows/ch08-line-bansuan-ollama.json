    {
      "id": "w7",
      "name": "เตรียมข้อมูล",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -100
      ],
      "parameters": {
        "jsCode": "// ค่าตั้งของระบบ แก้ที่นี่ที่เดียว\n// ระหว่างทดสอบใช้ LINE API จำลองในเครื่อง เมื่อเชื่อม LINE OA จริงให้เปลี่ยนเป็น https://api.line.me\nconst LINE_API = 'http://localhost:5678/webhook/mock-line';\n\nconst out = [];\nfor (const item of $input.all()) {\n  const ev = item.json;\n  // รับเฉพาะเหตุการณ์จากแชตหนึ่งต่อหนึ่ง ข้ามข้อความจากกลุ่มและเหตุการณ์ที่ไม่มี reply token\n  if (!ev.replyToken || ev.source?.type !== 'user') continue;\n  // เวลาทำการคิดจากเวลาที่ประชาชนส่งข้อความ จันทร์ถึงศุกร์ 08:30 ถึง 16:30 น.\n  const t = DateTime.fromMillis(ev.timestamp, { zone: 'Asia/Bangkok' });\n  const minutes = t.hour * 60 + t.minute;\n  const inOffice = t.weekday <= 5 && minutes >= 8 * 60 + 30 && minutes < 16 * 60 + 30;\n  let kind = 'other';\n  if (ev.type === 'follow') kind = 'follow';\n  else if (ev.type === 'message' && ev.message.type === 'text') kind = 'text';\n  out.push({ json: {\n    kind,\n    message_type: ev.message?.type ?? ev.type,\n    text: ev.message?.text ?? '',\n    user_id: ev.source.userId,\n    session_key: 'line:' + ev.source.userId,\n    reply_token: ev.replyToken,\n    in_office_hours: inOffice,\n    received_at: t.toFormat('yyyy-MM-dd HH:mm'),\n    line_api: LINE_API,\n  } });\n}\nreturn out;"
      }
    },
