    {
      "id": "q3",
      "name": "เตรียมคำถาม",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        -500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ข้อความสั้นที่ตามหลังคำถามอื่น มักเป็นคำถามต่อเนื่อง เช่น \"แล้วร้านอาหารล่ะ\"\n// นำคำถามสองข้อล่าสุดของคนเดียวกันมาประกอบ เพื่อให้ค้นเอกสารเจอเรื่องที่คุยกันอยู่\nconst p = $('เตรียมข้อมูล').item.json;\nconst previous = ($json.messages ?? []).map(m => m.human).filter(Boolean).slice(-2);\nconst isFollowUp = previous.length > 0 && p.text.length <= 35;\nconst question = isFollowUp\n  ? `คำถามก่อนหน้า: ${previous.join(' / ')}\nคำถามล่าสุด: ${p.text}`\n  : p.text;\nreturn { json: { question, is_follow_up: isFollowUp } };"
      }
    },
    {
      "id": "q9",
      "name": "ถามตอบจากเอกสาร",
      "type": "@n8n/n8n-nodes-langchain.chainRetrievalQa",
      "typeVersion": 1.7,
      "position": [
        2500,
        -500
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "options": {
          "systemPromptTemplate": "คุณคือเจ้าหน้าที่ตอบคำถามประชาชนของเทศบาลเมืองบ้านสวน\nตอบจากข้อความในส่วน \"เอกสารที่ค้นได้\" ด้านล่างเท่านั้น ห้ามใช้ความรู้ทั่วไปหรือเดาตัวเลข\nถ้าเอกสารที่ค้นได้ไม่มีคำตอบ ให้ตอบว่า \"ยังไม่มีข้อมูลเรื่องนี้ในเอกสารของเทศบาล ติดต่อ 0 4400 1234 ค่ะ\"\nตอบภาษาสุภาพที่คนทั่วไปเข้าใจ ลงท้ายด้วย ค่ะ ไม่เกินห้าบรรทัด\nบรรทัดสุดท้ายเขียนว่า ที่มา: ตามด้วยชื่อเอกสารที่ขึ้นต้นด้วยคำว่า \"เอกสาร:\" ที่ใช้ตอบ\nถ้าคำถามมีทั้งคำถามก่อนหน้าและคำถามล่าสุด ให้ตอบเฉพาะคำถามล่าสุด โดยใช้คำถามก่อนหน้าเป็นบริบท\n----------------\nเอกสารที่ค้นได้:\n{context}"
        }
