    {
      "id": "q14",
      "name": "คำตอบจากเอกสาร",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3400,
        -500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// LINE แสดงเครื่องหมาย Markdown เป็นตัวอักษรตรง ๆ จึงลบด้วยโค้ดแทนการสั่งโมเดล\nlet text = String($json.response ?? '').replace(/\\*\\*|__/g, '').replace(/^#+\\s*/gm, '').trim();\n// ถ้าตอบว่าไม่มีข้อมูล ให้ตัดบรรทัดที่มาออก เพราะไม่มีเอกสารใดใช้ตอบจริง\nif (text.includes('ยังไม่มีข้อมูลเรื่องนี้')) {\n  text = 'ยังไม่มีข้อมูลเรื่องนี้ในเอกสารของเทศบาล ติดต่อ 0 4400 1234 ในเวลาราชการค่ะ';\n}\nreturn { json: { reply_text: text } };"
      }
