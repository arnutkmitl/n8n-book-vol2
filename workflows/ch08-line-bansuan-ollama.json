        "emailFormat": "text",
        "text": "=เลขที่: {{ $json.ticket_no }}\nเวลา: {{ $('เตรียมข้อมูล').item.json.received_at }}\nLINE userId: {{ $('เตรียมข้อมูล').item.json.user_id }}\n\nข้อความ:\n{{ $('เตรียมข้อมูล').item.json.text }}",
