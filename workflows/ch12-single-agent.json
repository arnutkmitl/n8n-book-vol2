    {
      "id": "c3c",
      "name": "create_complaint",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        760,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "บันทึกเรื่องร้องเรียนใหม่ เรียกเมื่อรู้ทั้งปัญหาและสถานที่แล้วเท่านั้น คืนเลขที่เรื่อง (ticket_no)",
        "operation": "executeQuery",
        "query": "-- บันทึกเรื่องร้องเรียนจากผู้ช่วยกลาง ใช้ตารางเดียวกับบทที่ 8 และ 9\n-- เก็บ sessionId ของแชตในคอลัมน์ line_user_id เพื่อหาเรื่องทั้งหมดของผู้ใช้คนเดียวกันได้\nINSERT INTO citizen_requests (channel, kind, message, location, line_user_id)\nVALUES ('chat', 'complaint', $1, $2, $3)\nRETURNING ticket_no, status;",
        "options": {
          "queryReplacement": "={{ [$fromAI('problem', 'ปัญหาที่ประชาชนแจ้ง เขียนเป็นประโยคเดียว', 'string'), $fromAI('location', 'สถานที่เกิดเหตุตามที่ประชาชนบอก', 'string'), $('รับข้อความแชต').first().json.sessionId] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE",
          "name": "Postgres lab"
        }
      }
    },
    {
      "id": "c3k",
      "name": "check_ticket",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        960,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "ดูสถานะเรื่องร้องเรียนจากเลขที่ BS- คืนสถานะ หน่วยงานที่รับผิดชอบ และวันครบกำหนด",
        "operation": "executeQuery",
        "query": "SELECT ticket_no, status, department, to_char(due_date, 'DD/MM/YYYY') AS due_date\nFROM citizen_requests WHERE ticket_no = upper(trim($1));",
        "options": {
          "queryReplacement": "={{ [$fromAI('ticket_no', 'เลขที่เรื่อง ขึ้นต้นด้วย BS- เช่น BS-000123', 'string')] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE",
          "name": "Postgres lab"
        }
      }
