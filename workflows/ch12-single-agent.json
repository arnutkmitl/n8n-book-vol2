{
  "name": "ch12 Agent เดียว (ตัวเปรียบเทียบ)",
  "nodes": [
    {
      "id": "t1",
      "name": "รับข้อความแชต",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
