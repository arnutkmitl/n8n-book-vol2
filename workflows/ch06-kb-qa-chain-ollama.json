{
  "name": "ch06 ถามตอบจากเอกสารเทศบาล (Q&A Chain)",
  "nodes": [
    {
      "id": "c1",
      "name": "รับข้อความแชต",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "webhookId": "ch06-kb-chain",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "c2",
      "name": "Question and Answer Chain",
      "type": "@n8n/n8n-nodes-langchain.chainRetrievalQa",
      "typeVersion": 1.7,
      "position": [
        300,
        0
      ],
      "parameters": {
        "options": {
          "systemPromptTemplate": "คุณคือเจ้าหน้าที่ตอบคำถามประชาชนของเทศบาลเมืองบ้านสวน\nตอบจากข้อความในส่วน \"เอกสารที่ค้นได้\" ด้านล่างเท่านั้น ห้ามใช้ความรู้ทั่วไปหรือเดาตัวเลข\nถ้าเอกสารที่ค้นได้ไม่มีคำตอบ ให้ตอบว่า \"ยังไม่มีข้อมูลเรื่องนี้ในเอกสารของเทศบาล ติดต่อ 0 4400 1234 ค่ะ\"\nตอบภาษาสุภาพที่คนทั่วไปเข้าใจ ลงท้ายด้วย ค่ะ ไม่เกินห้าบรรทัด\nบรรทัดสุดท้ายเขียนว่า ที่มา: ตามด้วยชื่อเอกสารที่ขึ้นต้นด้วยคำว่า \"เอกสาร:\" ที่ใช้ตอบ\n----------------\nเอกสารที่ค้นได้:\n{context}"
        }
      }
    },
    {
      "id": "c3",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        160,
        240
      ],
      "parameters": {
        "model": "qwen2.5:3b",
        "options": {
          "temperature": 0,
          "numCtx": 8192,
          "numPredict": 512
        }
      },
      "credentials": {
        "ollamaApi": {
          "id": "REPLACE",
          "name": "Ollama local"
        }
      }
    },
    {
      "id": "c4",
      "name": "Vector Store Retriever",
      "type": "@n8n/n8n-nodes-langchain.retrieverVectorStore",
      "typeVersion": 1,
      "position": [
        420,
        240
      ],
      "parameters": {
        "topK": 4
      }
    },
    {
      "id": "c5",
      "name": "Postgres PGVector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        420,
        440
      ],
      "parameters": {
        "mode": "retrieve",
        "tableName": "kb_bansuan",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE",
          "name": "Postgres lab"
        }
      }
    },
    {
      "id": "c6",
      "name": "Embeddings Ollama",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [
        420,
        640
      ],
      "parameters": {
        "model": "bge-m3:latest"
      },
      "credentials": {
        "ollamaApi": {
          "id": "REPLACE",
          "name": "Ollama local"
        }
      }
    }
  ],
