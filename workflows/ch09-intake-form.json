    {
      "id": "f2",
      "name": "บันทึกเรื่องรับ",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO citizen_requests (channel, kind, sender, contact, subject, message, location, source_ref)\nVALUES ($1, 'incoming', $2, $3, $4, $5, $6, $7)\nON CONFLICT (source_ref) WHERE source_ref IS NOT NULL DO NOTHING\nRETURNING id, ticket_no;",
        "options": {
          "queryReplacement": "={{ ['form', $json.sender, $json.contact, $json.subject, $json.detail, $json.location || null, null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE",
          "name": "Postgres lab"
        }
      }
    },
