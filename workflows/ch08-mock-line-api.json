    {
      "id": "m12",
      "name": "อ่านข้อความที่ส่งออก",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        620
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(json_agg(t ORDER BY id), '[]'::json) AS messages FROM (\n  SELECT id, kind, reply_token, to_user, payload->'messages'->0->>'text' AS text, created_at\n  FROM line_mock_outbox WHERE id > $1) t;",
        "options": {
          "queryReplacement": "={{ Number($json.query.after || 0) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE",
          "name": "Postgres lab"
        }
      }
    },
