        "options": {}
      }
    },
    {
      "id": "m2",
      "name": "บันทึก reply ถ้า token ยังใช้ได้",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "-- reply token ใช้ได้ครั้งเดียว และต้องใช้ภายใน 60 วินาที เหมือน LINE จริง\nINSERT INTO line_mock_outbox (kind, reply_token, payload)\nSELECT 'reply', $1, $2::jsonb WHERE $3::boolean\nON CONFLICT (reply_token) WHERE reply_token IS NOT NULL DO NOTHING\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.body.replyToken, JSON.stringify($json.body), (() => { const m = /^rt-(\\d+)/.exec($json.body.replyToken || ''); return !!m && Date.now() - Number(m[1]) <= 60000 && String($json.headers.authorization || '').startsWith('Bearer '); })()] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE",
          "name": "Postgres lab"
        }
      }
    },
    {
      "id": "m3",
      "name": "บันทึกได้หรือไม่",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "x",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
