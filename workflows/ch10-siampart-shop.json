    {
      "id": "m3",
      "name": "เตรียมคำถาม",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// คำถามสั้นที่ตามหลังคำถามอื่น นำคำถามสองข้อล่าสุดของลูกค้าคนเดียวกันมาประกอบ (วิธีเดียวกับบทที่ 8)\nconst text = $('รับข้อความแชต').first().json.chatInput;\nconst previous = ($json.messages ?? []).map(m => m.human).filter(Boolean).slice(-2);\nconst isFollowUp = previous.length > 0 && text.length <= 35;\nconst question = isFollowUp ? `คำถามก่อนหน้า: ${previous.join(' / ')}\\nคำถามล่าสุด: ${text}` : text;\nreturn { json: { question } };"
      }
    },
