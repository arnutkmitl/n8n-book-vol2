      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ล้างเครื่องหมาย Markdown และตัดบรรทัดที่มาเมื่อไม่มีข้อมูล (วิธีเดียวกับบทที่ 8)\nlet text = String($json.response ?? '').replace(/\\*\\*|__/g, '').replace(/^#+\\s*/gm, '').trim();\nif (text.includes('ยังไม่มีข้อมูลเรื่องนี้')) {\n  text = 'ยังไม่มีข้อมูลเรื่องนี้ในคู่มือของร้าน รบกวนสอบถามพนักงานขายในแชตนี้ได้ครับ';\n}\nreturn { json: { output: text, route: 'manual' } };"
