        "fileSelector": "/files/kb-siampart/*.md",
        "options": {}
      }
    },
    {
      "id": "i3",
      "name": "แปลงเป็นข้อความ",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        400,
        0
      ],
      "parameters": {
        "operation": "text",
        "options": {}
      }
    },
    {
      "id": "i4",
      "name": "ตัดตามหัวข้อ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "// ตัดเอกสารเป็นชิ้นตามหัวข้อระดับ ## และใส่ชื่อเอกสารนำหน้าทุกชิ้น\n// ชิ้นที่ค้นเจอจะบอกได้เองว่ามาจากเอกสารใด แม้ไม่ได้อยู่ต้นไฟล์\nconst files = $('อ่านไฟล์เอกสาร').all();\nconst out = [];\n$input.all().forEach((item, i) => {\n  // แก้สระอำที่ถูกแยกเป็นนิคหิต + สระอา (พบในข้อความที่ดึงจาก PDF)\n  const text = item.json.data.replace(/ํา/g, 'ำ');\n  const lines = text.split('\\n');\n  const title = lines[0].replace(/^#\\s*/, '').trim();\n  const body = lines.slice(1).join('\\n');\n  const sections = body.split(/\\n(?=## )/).map(s => s.trim()).filter(s => s.length > 0);\n  const hasHeadings = sections.some(s => s.startsWith('## '));\n  for (const sec of sections) {\n    // ข้ามส่วนนำก่อนหัวข้อแรก (มักเป็นคำชี้แจงสั้น ๆ) เมื่อเอกสารมีหัวข้อแล้ว\n    if (hasHeadings && !sec.startsWith('## ')) continue;\n    const heading = sec.startsWith('## ') ? sec.split('\\n')[0].replace(/^##\\s*/, '') : 'ส่วนนำ';\n    out.push({ json: {\n      source: files[i].json.fileName,\n      title,\n      section: heading,\n      text: `เอกสาร: ${title}\\n${sec}`,\n    } });\n  }\n});\nreturn out;\n"
      }
    },
    {
