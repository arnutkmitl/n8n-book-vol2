                "name": "THAI_ID",
                "value": "/\\b\\d[-\\s]?\\d{4}[-\\s]?\\d{5}[-\\s]?\\d{2}[-\\s]?\\d\\b/g"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "รับข้อความ": {
      "main": [
        [
          {
            "node": "ปิดบังข้อมูลส่วนบุคคล",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
