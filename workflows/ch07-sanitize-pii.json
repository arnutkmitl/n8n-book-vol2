      ],
      "webhookId": "ch07-sanitize",
      "parameters": {
        "httpMethod": "POST",
        "path": "ch07-sanitize",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "s2",
      "name": "ปิดบังข้อมูลส่วนบุคคล",
      "type": "@n8n/n8n-nodes-langchain.guardrails",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "sanitize",
        "text": "={{ $json.body.text }}",
        "guardrails": {
          "pii": {
